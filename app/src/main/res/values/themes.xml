<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DescargarMultimedia" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Actividad transparente: solo se ve el diálogo sobre la app de origen -->
    <style name="Theme.DescargarMultimedia.Translucent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
